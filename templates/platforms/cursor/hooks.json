{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "SUNSHINE_HOOK_PLATFORM=cursor sunshine hook shell-session",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "SUNSHINE_HOOK_PLATFORM=cursor sunshine hook subagent-context",
        "matcher": "Task|Subagent",
        "timeout": 30
      }
    ],
    "subagentStop": [
      {
        "command": "SUNSHINE_HOOK_PLATFORM=cursor sunshine hook subagent-stop",
        "matcher": "sunshine-implement|sunshine-check|sunshine-research|sunshine-prototype",
        "timeout": 30
      }
    ],
    "sessionStart": [
      {
        "command": "SUNSHINE_HOOK_PLATFORM=cursor sunshine hook session-start",
        "timeout": 30
      }
    ]
  }
}
