{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "SUNSHINE_HOOK_PLATFORM=droid sunshine hook session-start",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "SUNSHINE_HOOK_PLATFORM=droid sunshine hook session-start",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "SUNSHINE_HOOK_PLATFORM=droid sunshine hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "SUNSHINE_HOOK_PLATFORM=droid sunshine hook subagent-context",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Execute|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "SUNSHINE_HOOK_PLATFORM=droid sunshine hook shell-session",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SUNSHINE_HOOK_PLATFORM=droid sunshine hook workflow-state",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
