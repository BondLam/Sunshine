{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "SUNSHINE_HOOK_PLATFORM=qoder sunshine hook session-start",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "SUNSHINE_HOOK_PLATFORM=qoder sunshine hook session-start",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "SUNSHINE_HOOK_PLATFORM=qoder sunshine hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "SUNSHINE_HOOK_PLATFORM=qoder sunshine hook shell-session",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SUNSHINE_HOOK_PLATFORM=qoder sunshine hook workflow-state",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
